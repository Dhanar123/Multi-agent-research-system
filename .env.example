# Groq API Key (Get yours at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tavily API Key (Get yours at https://tavily.com)
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# Optional: Groq Model (defaults to llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
